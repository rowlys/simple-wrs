# Copy to .env and replace every change-me value. .env is git-ignored.

# db (technical spec §10). The password must be URL-safe (no @ / :) because it is embedded in DATABASE_URL.
POSTGRES_USER=wrs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wrs

# api
DATABASE_URL=postgresql://wrs:change-me@db:5432/wrs?schema=public
JWT_SECRET=change-me-32-plus-random-chars
JWT_EXPIRES_IN=8h
PORT=3000

# seed
SEED_ON_START=false
SEED_SUPERVISOR_PASSWORD=change-me
SEED_OPERATOR_PASSWORD=change-me

# web
WEB_PORT=8080
