# Copy to backend/.env (git-ignored) to run the API on this machine: `npm run dev` (D-35).
# The Docker stack does not use this file; it takes its configuration from the repository's .env.
# Replace every change-me value. The database is the Compose db service, published on 127.0.0.1:5432
# (`docker compose up -d db`): use the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB of the repository's .env.

DATABASE_URL=postgresql://wrs:change-me@127.0.0.1:5432/wrs?schema=public
JWT_SECRET=change-me-32-plus-random-chars
JWT_EXPIRES_IN=8h
PORT=3000

# npm run seed (users + products) and npm run seed:demo (demo documents, through the running API at API_URL;
# keep its port equal to PORT)
SEED_SUPERVISOR_PASSWORD=change-me
SEED_OPERATOR_PASSWORD=change-me
API_URL=http://localhost:3000
