{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.js\"",
            "timeout": 10,
            "statusMessage": "Checking migration protection..."
          }
        ]
      }
    ]
  }
}
